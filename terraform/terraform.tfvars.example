ssh_public_key        = "ssh-rsa AAAAB3N..."
azure_subscription_id = "00000000-0000-0000-0000-000000000000"
gcp_project_id        = "my-gcp-chaos-project"
tailscale_auth_key    = "tskey-auth-xxxxxx-xxxxxx"

# Used by all nodes to find each other via MagicDNS
cluster_join_nodes = "crdb-aws-1,crdb-aws-2,crdb-azure-1,crdb-azure-2,crdb-gcp-1"

aws_config = {
  nodes = {
    node1 = {
      enabled       = true
      region        = "us-east-1"
      vpc_cidr      = "10.1.0.0/16"
      subnet_cidr   = "10.1.1.0/24"
      instance_type = "t3.medium"
      hostname      = "crdb-aws-1"
    }
    node2 = {
      enabled       = true
      region        = "us-west-2"
      vpc_cidr      = "10.2.0.0/16"
      subnet_cidr   = "10.2.1.0/24"
      instance_type = "t3.medium"
      hostname      = "crdb-aws-2"
    }
  }
}

azure_config = {
  nodes = {
    node1 = {
      enabled     = true
      region      = "eastus"
      vnet_cidr   = "10.3.0.0/16"
      subnet_cidr = "10.3.1.0/24"
      vm_size     = "Standard_B2ls_v2"
      hostname    = "crdb-azure-1"
    }
    node2 = {
      enabled     = true
      region      = "westus"
      vnet_cidr   = "10.4.0.0/16"
      subnet_cidr = "10.4.1.0/24"
      vm_size     = "Standard_B2ls_v2"
      hostname    = "crdb-azure-2"
    }
  }
}

gcp_config = {
  nodes = {
    node1 = {
      enabled      = true
      region       = "us-central1"
      zone         = "us-central1-a"
      vpc_cidr     = "10.5.0.0/16"
      machine_type = "e2-medium"
      hostname     = "crdb-gcp-1"
    }
  }
}