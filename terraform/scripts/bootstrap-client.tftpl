#!/bin/bash
set -e

export DEBIAN_FRONTEND=noninteractive
apt-get update -yq
apt-get install -yq wget tar curl chrony haproxy postgresql-client \
  python3 python3-pip

# psycopg 3 for the RTO probe agent (Ubuntu 22.04 has no apt package for it).
pip3 install --no-cache-dir "psycopg[binary]>=3.1"

# --- 1. Install & Configure Tailscale Mesh ---
echo "Installing Tailscale..."
curl -fsSL https://tailscale.com/install.sh | sh
tailscale up --authkey="${tailscale_key}" --hostname="${hostname}" --accept-dns=true

echo "Waiting for Tailscale IP assignment..."
TS_IP=""
while [ -z "$TS_IP" ]; do
    sleep 2
    TS_IP=$(tailscale ip -4 || true)
done
echo "Node registered on mesh with IP: $TS_IP"

# Pin this node's own name to the address to avoid MagicDNS resolving to link-local
grep -qxF "$TS_IP ${hostname}" /etc/hosts || echo "$TS_IP ${hostname}" >> /etc/hosts

# --- 2. NTP & Clock Sync ---
echo "Configuring Chrony..."
systemctl enable chrony
systemctl start chrony
chronyc makestep || true
chronyc tracking

# --- 3. Install CockroachDB (Client Only) ---
echo "Installing CockroachDB v26.3.0 for client binaries..."
wget -qO- https://binaries.cockroachdb.com/cockroach-v26.3.0.linux-amd64.tgz | tar xvz
cp -i cockroach-v26.3.0.linux-amd64/cockroach /usr/local/bin/

# We do NOT run cockroach start-single-node. This is a pure load generator node.

# --- 4. Configure HAProxy for Patroni/PostgreSQL ---
# HAProxy routes :5000 to the current Patroni primary (health-checked on :8008/primary).
IFS=',' read -ra PEERS <<< "${join_nodes}"

cat <<'EOF'  > /etc/haproxy/haproxy.cfg
global
    log /dev/log local0
    log /dev/log local1 notice
    maxconn 4096
    user haproxy
    group haproxy
    daemon

defaults
    log     global
    mode    tcp
    option  tcplog
    option  dontlognull
    retries 3
    timeout connect 5s
    # Idle timeout: pgbouncer opens the generator's connections one at a time, so
    # early ones sit idle for minutes before first use.
    timeout client  3600s
    timeout server  3600s

frontend db_front
    bind *:5000
    default_backend patroni_primary

backend patroni_primary
    option httpchk GET /primary
    http-check expect status 200
    # init-addr lets HAProxy start before the MagicDNS names resolve at first boot.
    default-server inter 3s fall 3 rise 2 on-marked-down shutdown-sessions init-addr last,libc,none
EOF

for peer in "$${PEERS[@]}"; do
    if [ "$peer" != "${hostname}" ]; then
        echo "    server $peer $peer:5432 maxconn 1000 check port 8008" >> /etc/haproxy/haproxy.cfg
    fi
done

# Give MagicDNS a bounded chance to settle before starting, so the common case
# starts with real addresses rather than relying on init-addr's fallback.
echo "Waiting for peer names to resolve..."
for _ in $(seq 1 30); do
    UNRESOLVED=0
    for peer in "$${PEERS[@]}"; do
        [ "$peer" = "${hostname}" ] && continue
        getent hosts "$peer" >/dev/null 2>&1 || UNRESOLVED=1
    done
    [ "$UNRESOLVED" = "0" ] && break
    sleep 5
done

systemctl enable haproxy
systemctl restart haproxy

# Verify HAProxy is actually listening; a dead proxy fails every phase much later.
HAPROXY_UP=0
for _ in $(seq 1 12); do
    if ss -lnt 2>/dev/null | grep -q ':5000 '; then
        HAPROXY_UP=1
        break
    fi
    sleep 5
done
if [ "$HAPROXY_UP" != "1" ]; then
    echo "FAILED: haproxy is not listening on :5000 after 60s." >&2
    systemctl status haproxy --no-pager >&2 || true
    /usr/sbin/haproxy -f /etc/haproxy/haproxy.cfg -c >&2 || true
    exit 1
fi

# --- 4b. pgbouncer in front of HAProxy: drops the allow_unsafe_internals startup
# parameter cockroach workload sends, which PostgreSQL rejects ---
apt-get install -yq pgbouncer

cat <<'EOF'  > /etc/pgbouncer/pgbouncer.ini
[databases]
* = host=127.0.0.1 port=5000 user=root password=rootpassword

[pgbouncer]
listen_addr = 127.0.0.1
listen_port = 6432
auth_type = trust
auth_file = /etc/pgbouncer/userlist.txt
logfile = /var/log/postgresql/pgbouncer.log
pidfile = /var/run/postgresql/pgbouncer.pid
pool_mode = session
# Headroom over the largest tier (200) and under the cluster's max_connections (500).
max_client_conn = 600
default_pool_size = 300
# DISCARD ALL clears the generator's prepared statements between clients.
server_reset_query = DISCARD ALL
ignore_startup_parameters = allow_unsafe_internals,extra_float_digits,options,search_path
EOF

echo '"root" ""' > /etc/pgbouncer/userlist.txt
chown -R postgres:postgres /etc/pgbouncer
systemctl enable pgbouncer
systemctl restart pgbouncer

PGBOUNCER_UP=0
for _ in $(seq 1 12); do
    if ss -lnt 2>/dev/null | grep -q ':6432 '; then
        PGBOUNCER_UP=1
        break
    fi
    sleep 5
done
if [ "$PGBOUNCER_UP" != "1" ]; then
    echo "FAILED: pgbouncer is not listening on :6432 after 60s." >&2
    systemctl status pgbouncer --no-pager >&2 || true
    exit 1
fi

# --- 5. node_exporter -- hardware metrics polled directly by the harness ---
# Polled directly over the tailnet by crdblab/core/hardware_metrics.py.
apt-get install -yq prometheus-node-exporter
systemctl enable prometheus-node-exporter
systemctl restart prometheus-node-exporter

NODE_EXPORTER_UP=0
for _ in $(seq 1 12); do
    if ss -lnt 2>/dev/null | grep -q ':9100 '; then
        NODE_EXPORTER_UP=1
        break
    fi
    sleep 5
done
if [ "$NODE_EXPORTER_UP" != "1" ]; then
    echo "FAILED: node_exporter is not listening on :9100 after 60s." >&2
    systemctl status prometheus-node-exporter --no-pager >&2 || true
    exit 1
fi

echo "✅ Client node provisioned successfully."
