#!/bin/bash
set -e

export DEBIAN_FRONTEND=noninteractive
apt-get update -yq
apt-get install -yq wget tar curl chrony haproxy postgresql-client \
  python3 python3-pip

# psycopg (v3) is the RTO probe agent's only non-stdlib dependency. The probe
# runs on this node rather than on the operator's workstation so its resolution
# is bounded by the cost of a quorum write rather than by the operator's uplink
# -- see crdblab/core/remote_probe.py for the measurements that motivated it.
#
# Installed with pip rather than apt on purpose: Ubuntu 22.04, which this image
# is, ships no python3-psycopg package (only psycopg2, a different API the agent
# does not use). The version constraint matches pyproject.toml's, so the agent
# runs the same driver the harness does.
pip3 install --no-cache-dir "psycopg[binary]>=3.1"

# ==========================================
# 1. Install & Configure Tailscale Mesh
# ==========================================
echo "Installing Tailscale..."
curl -fsSL https://tailscale.com/install.sh | sh
tailscale up --authkey="${tailscale_key}" --hostname="${hostname}" --accept-dns=true

echo "Waiting for Tailscale IP assignment..."
TS_IP=""
while [ -z "$TS_IP" ]; do
    sleep 2
    TS_IP=$(tailscale ip -4 || true)
done
echo "Node registered on mesh with IP: $TS_IP"

# Pin this node's own name to the address to avoid MagicDNS resolving to link-local
grep -qxF "$TS_IP ${hostname}" /etc/hosts || echo "$TS_IP ${hostname}" >> /etc/hosts

# ==========================================
# 2. NTP & Clock Sync
# ==========================================
echo "Configuring Chrony..."
systemctl enable chrony
systemctl start chrony
chronyc makestep || true
chronyc tracking

# ==========================================
# 3. Install CockroachDB (Client Only)
# ==========================================
echo "Installing CockroachDB v26.3.0 for client binaries..."
wget -qO- https://binaries.cockroachdb.com/cockroach-v26.3.0.linux-amd64.tgz | tar xvz
cp -i cockroach-v26.3.0.linux-amd64/cockroach /usr/local/bin/

# We do NOT run cockroach start-single-node. This is a pure load generator node.

# ==========================================
# 4. Configure HAProxy for Patroni/PostgreSQL
# ==========================================
# In PostgreSQL mode, this HAProxy routes port 5000 to the current Patroni primary.
# The nodes list is injected via the join_nodes variable.
IFS=',' read -ra PEERS <<< "${join_nodes}"

cat <<EOF > /etc/haproxy/haproxy.cfg
global
    log /dev/log local0
    log /dev/log local1 notice
    maxconn 4096
    user haproxy
    group haproxy
    daemon

defaults
    log     global
    mode    tcp
    option  tcplog
    option  dontlognull
    retries 3
    timeout connect 5s
    timeout client  300s
    timeout server  300s

frontend db_front
    bind *:5000
    default_backend patroni_primary

backend patroni_primary
    option httpchk GET /primary
    http-check expect status 200
    # init-addr is not optional here. HAProxy resolves every `server`
    # hostname once at startup and refuses to start if any of them fails --
    # and at first boot these are Tailscale MagicDNS names that frequently do
    # not resolve yet, because this node joins the mesh in the same cloud-init
    # run. Observed 2026-09-08: the whole deployment came up with haproxy
    # dead ("Start request repeated too quickly", `haproxy -c` failing), while
    # the very same config validated cleanly minutes later once DNS had
    # settled. `last,libc,none` lets it start with the address unresolved and
    # pick the peer up on a later health check instead.
    default-server inter 3s fall 3 rise 2 on-marked-down shutdown-sessions init-addr last,libc,none
EOF

for peer in "$${PEERS[@]}"; do
    if [ "$peer" != "${hostname}" ]; then
        echo "    server $peer $peer:5432 maxconn 1000 check port 8008" >> /etc/haproxy/haproxy.cfg
    fi
done

# Give MagicDNS a bounded chance to settle before starting, so the common case
# starts with real addresses rather than relying on init-addr's fallback.
echo "Waiting for peer names to resolve..."
for _ in $(seq 1 30); do
    UNRESOLVED=0
    for peer in "$${PEERS[@]}"; do
        [ "$peer" = "${hostname}" ] && continue
        getent hosts "$peer" >/dev/null 2>&1 || UNRESOLVED=1
    done
    [ "$UNRESOLVED" = "0" ] && break
    sleep 5
done

systemctl enable haproxy
systemctl restart haproxy

# Verify rather than assume, for the same reason the Patroni bootstrap does:
# `systemctl restart` returning 0 is not the same as a listener existing, and
# a client node whose HAProxy is dead fails every measured phase later with
# "connection refused" on 127.0.0.1:5000 -- a long way from the cause.
HAPROXY_UP=0
for _ in $(seq 1 12); do
    if ss -lnt 2>/dev/null | grep -q ':5000 '; then
        HAPROXY_UP=1
        break
    fi
    sleep 5
done
if [ "$HAPROXY_UP" != "1" ]; then
    echo "FAILED: haproxy is not listening on :5000 after 60s." >&2
    systemctl status haproxy --no-pager >&2 || true
    /usr/sbin/haproxy -f /etc/haproxy/haproxy.cfg -c >&2 || true
    exit 1
fi

echo "✅ Client node provisioned successfully."
