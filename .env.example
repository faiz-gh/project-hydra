# Cluster entrypoint URI for data loading and `crdblab capture` only -- never
# read by the measured phases (bench, chaos run), which resolve their own
# connection strings from crdblab/topology.py and --engine.
#
# For CockroachDB, a multi-host URI lets loading/capture survive the primary
# being down; give EVERY host its own :26257 -- a single trailing port only
# covers hosts that omit one, silently defaulting the rest to 5432:
DB_URI="postgresql://root@crdb-gcp-1:26257,crdb-linode-1:26257,crdb-linode-2:26257,crdb-azure-1:26257,crdb-azure-2:26257/ycsb?sslmode=disable"
# For PostgreSQL, the credential is not optional and the host is not a cluster
# node. Patroni bootstraps `pg_hba` as `host all all 0.0.0.0/0 md5`, so every
# TCP connection needs a password -- unlike CockroachDB, which runs --insecure
# and takes `root` with none -- and only the client node's HAProxy on :5000
# follows the leader through a failover. The user/password are the ones
# terraform/scripts/bootstrap-patroni.tftpl creates:
# DB_URI="postgresql://root:rootpassword@127.0.0.1:5000/ycsb?sslmode=disable"

# The measured phases build their own PostgreSQL DSNs and take the password
# from here, not from DB_URI. Defaults to the bootstrap's `rootpassword`;
# set it if you change the template.
# PG_PASSWORD="rootpassword"

CRDBLAB_RUNS_DIR="runs"
