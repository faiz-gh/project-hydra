# DB_URI is derived per engine by run-experiment.sh; to override it, uncomment one:

# DB_URI_COCKROACHDB="postgresql://root@crdb-gcp-1:26257/ycsb?sslmode=disable"
# DB_URI_POSTGRESQL="postgresql://root:rootpassword@127.0.0.1:5000/ycsb?sslmode=disable"

# Tailscale API access token: the full pipeline deletes the VMs' tailnet devices
# after each destroy. Create one under Settings -> Keys (expires within 90 days).
TS_API_KEY=""
# Tailnet name; "-" means the tailnet the key belongs to.
# TS_TAILNET="-"

# PostgreSQL root password; must match terraform/scripts/bootstrap-patroni.tftpl.
PG_PASSWORD="rootpassword"

CRDBLAB_RUNS_DIR="runs"
