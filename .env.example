# DB_URI is no longer set here. run-experiment.sh derives it from --engine
# (crdblab.config.default_db_uri), so nothing needs editing between the
# CockroachDB and PostgreSQL deployments. It feeds only data loading and
# `crdblab capture`, never the measured phases. The derived values are:
#   cockroachdb: postgresql://root@crdb-gcp-1:26257,crdb-linode-1:26257,...,crdb-azure-2:26257/ycsb?sslmode=disable
#   postgresql:  postgresql://root:<PG_PASSWORD>@127.0.0.1:5000/ycsb?sslmode=disable
# (the client node's HAProxy, the only endpoint that follows a Patroni failover).
# To override one engine's URI, set it explicitly:
# DB_URI_COCKROACHDB="postgresql://root@crdb-gcp-1:26257/ycsb?sslmode=disable"
# DB_URI_POSTGRESQL="postgresql://root:rootpassword@127.0.0.1:5000/ycsb?sslmode=disable"

# Tailscale API access token, used by the full pipeline (./run-experiment.sh with
# no arguments) to delete the six VMs' devices after each `terraform destroy`,
# so the next deploy gets crdb-gcp-1 rather than crdb-gcp-1-1. Create one in the
# admin console: Settings -> Keys -> Generate access token. It expires (max 90
# days); the pipeline's preflight fails early if it has.
TS_API_KEY=""
# Tailnet name; "-" means the tailnet the key belongs to.
# TS_TAILNET="-"

# The measured phases build their own PostgreSQL DSNs and take the password
# from here, not from DB_URI. Defaults to the bootstrap's `rootpassword`;
# set it if you change the template.
PG_PASSWORD="rootpassword"

CRDBLAB_RUNS_DIR="runs"
